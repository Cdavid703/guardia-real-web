rules_version = '2';

// ──────────────────────────────────────────────────────────────────
// GUARDIA REAL DE ANTIOQUIA — Reglas de seguridad de Firestore
// ──────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && myRole() == 'admin';
    }

    function isStaff() {
      return isAuth() && myRole() in ['admin', 'director', 'junta'];
    }

    function isMiembro() {
      return isAuth() && myRole() in ['admin', 'director', 'integrante', 'junta', 'cm', 'collector'];
    }

    // ¿La cuenta actual está enlazada a esta ficha? (varias cuentas por ficha + legacy)
    function fichaPropia() {
      return isAuth() && (
        request.auth.uid in resource.data.get('linkedUids', []) ||
        resource.data.get('linkedUid', '') == request.auth.uid
      );
    }

    // Perfil propio
    match /users/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isStaff());
      allow create: if isAuth() && request.auth.uid == uid
                     && request.resource.data.role == 'pending';
      allow update: if isAdmin()
                    || (isAuth() && request.auth.uid == uid
                        && request.resource.data.active == resource.data.active
                        && (
                          request.resource.data.role == resource.data.role
                          || (resource.data.role == 'pending' && request.resource.data.role == 'visitante')
                        ));
      allow delete: if false;
    }

    // Ingresos
    match /ingresos/{id} {
      allow read:   if isStaff();
      allow update: if isStaff();
      allow create: if false;
      allow delete: if isAdmin();
    }

    // Eventos públicos/internos
    match /events/{id} {
      allow read:  if isAuth() || resource.data.isPublic == true;
      allow write: if isAuth() && myRole() in ['admin', 'director'];
    }

    // Noticias — solo published+visibles se exponen al público; staff/cm ven todo
    match /news/{id} {
      allow read: if (resource.data.published == true &&
                       (!('visibleTo' in resource.data) ||
                        'public' in resource.data.visibleTo ||
                        (isAuth() && myRole() in resource.data.visibleTo)))
                   || (isAuth() && myRole() in ['admin', 'cm']);
      allow write: if isAuth() && myRole() in ['admin', 'cm'];
    }

    // Cotizaciones
    match /quotes/{id} {
      allow create: if true;
      allow read:   if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Galería — robusto ante documentos sin visibleTo
    match /gallery/{id} {
      allow read: if !('visibleTo' in resource.data)
                  || 'public' in resource.data.visibleTo
                  || (isAuth() && myRole() in resource.data.visibleTo);
      allow write: if isAuth() && myRole() in ['admin', 'cm'];
    }

    // Ensayos — robusto ante documentos sin visibleTo
    match /ensayos/{id} {
      allow read:  if isAuth() && (
                     !('visibleTo' in resource.data) ||
                     myRole() in resource.data.visibleTo
                   );
      allow write: if isAuth() && myRole() in ['admin', 'director'];
    }

    // Repertorio — robusto ante documentos sin visibleTo
    match /repertoire/{id} {
      allow read:  if isAuth() && (
                     !('visibleTo' in resource.data) ||
                     myRole() in resource.data.visibleTo
                   );
      allow write: if isAuth() && myRole() in ['admin', 'director'];
    }

    // Giras / viajes — miembros leen; staff (admin/director/junta) gestiona
    match /giras/{id} {
      allow read:  if isMiembro();
      allow write: if isStaff();
    }

    // Asistencia a ensayos — admin/director gestionan; cada integrante puede
    // auto-registrar SOLO su propia asistencia (validado contra su ficha).
    match /asistencias/{ensayoId} {
      allow read:  if isAuth() && myRole() in ['admin', 'director'];
      allow write: if isAuth() && myRole() in ['admin', 'director'];

      match /presentes/{integranteId} {
        allow read:  if (isAuth() && myRole() in ['admin', 'director'])
                     || (isAuth() && (
                         request.auth.uid in get(/databases/$(database)/documents/integrantes/$(integranteId)).data.get('linkedUids', [])
                         || get(/databases/$(database)/documents/integrantes/$(integranteId)).data.get('linkedUid', '') == request.auth.uid
                       ));
        allow write: if (isAuth() && myRole() in ['admin', 'director'])
                     || (isAuth() && (
                         request.auth.uid in get(/databases/$(database)/documents/integrantes/$(integranteId)).data.get('linkedUids', [])
                         || get(/databases/$(database)/documents/integrantes/$(integranteId)).data.get('linkedUid', '') == request.auth.uid
                       ));
      }
    }

    // Itinerarios de presentaciones — miembros leen; admin/director editan
    match /itinerarios/{id} {
      allow read:  if isMiembro();
      allow write: if isAuth() && myRole() in ['admin', 'director'];
    }

    // Confirmación de asistencia a eventos del itinerario — admin/director/junta ven todo;
    // cada integrante confirma/lee SOLO lo suyo (validado contra su ficha).
    match /confirmacionesItinerario/{id} {
      allow read:  if (isAuth() && myRole() in ['admin', 'director', 'junta'])
                   || (isAuth() && (
                       request.auth.uid in get(/databases/$(database)/documents/integrantes/$(resource.data.integranteId)).data.get('linkedUids', [])
                       || get(/databases/$(database)/documents/integrantes/$(resource.data.integranteId)).data.get('linkedUid', '') == request.auth.uid
                     ));
      allow write: if (isAuth() && myRole() in ['admin', 'director'])
                   || (isAuth() && (
                       request.auth.uid in get(/databases/$(database)/documents/integrantes/$(request.resource.data.integranteId)).data.get('linkedUids', [])
                       || get(/databases/$(database)/documents/integrantes/$(request.resource.data.integranteId)).data.get('linkedUid', '') == request.auth.uid
                     ));
    }

    // Pagos — admin y recaudador (collector) gestionan; el integrante ve solo los suyos
    match /pagos/{id} {
      allow read:  if isAuth() && myRole() in ['admin', 'collector']
                   || (isAuth() && (
                       request.auth.uid in get(/databases/$(database)/documents/integrantes/$(resource.data.integranteId)).data.get('linkedUids', [])
                       || get(/databases/$(database)/documents/integrantes/$(resource.data.integranteId)).data.get('linkedUid', '') == request.auth.uid
                     ));
      allow write: if isAuth() && myRole() in ['admin', 'collector'];
    }

    // Donaciones — formulario público crea; solo admin ve
    match /donations/{id} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Integrantes — roster NO sensible: visible a cualquier miembro de la banda.
    // Las cuentas enlazadas (linkedUids) pueden editar su ficha sin alterar el
    // conjunto de vínculos. Un usuario puede crear su propia ficha (self-service).
    match /integrantes/{id} {
      allow read:   if isMiembro();
      allow create: if isAdmin()
                    || (isAuth() && request.auth.uid in request.resource.data.get('linkedUids', []));
      allow update: if isAdmin() || fichaPropia();
      allow delete: if isAdmin();
    }

    // Integrantes — datos SENSIBLES (cédula, dirección, salud): solo admin o dueño(s).
    match /integrantesPrivado/{id} {
      allow read:   if isAdmin() || fichaPropia();
      allow create: if isAdmin()
                    || (isAuth() && request.auth.uid in request.resource.data.get('linkedUids', []));
      allow update: if isAdmin() || fichaPropia();
      allow delete: if isAdmin();
    }

    // Denegar todo lo demás (incluye stats/visitas, gestionado solo por Admin SDK)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
